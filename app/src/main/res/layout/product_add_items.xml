<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/ll_p_details"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">
        <!-- Product Name -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Service Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"/>
        <!-- Price Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/ll_price"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <!-- Original Price -->
<!--            <View-->
<!--                android:layout_width="30dp"-->
<!--                android:background="@color/black"-->
<!--                android:layout_height="1dp">-->
<!--                -->
<!--            </View>-->


            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹799.0"
                android:layout_marginTop="0dp"
                android:textColor="#808080"
                android:layout_marginEnd="8dp"/>
            <!-- Discounted Price -->

            </LinearLayout>
            <TextView
                android:id="@+id/tvDiscountedPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹649.0"
                android:textColor="#000000"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
    <!-- Quantity and Add Button Section -->
    <!-- Minus Button -->
    <!-- Quantity Text -->

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="35dp"
        android:padding="2dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:layout_marginRight="20dp"
        android:gravity="center"
        android:background="@drawable/ll_background"
        android:id="@+id/ll_add_cart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnPlus"
            android:layout_width="18dp"
            android:layout_height="25dp"
            android:layout_weight="0"
            android:src="@drawable/outline_add_24"
            app:layout_constraintRight_toLeftOf="@id/btnAdd"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_weight="0"
            android:gravity="center"
            android:text="0"
            android:textSize="16sp"
            app:layout_constraintRight_toLeftOf="@id/btnAdd"
            app:layout_constraintTop_toBottomOf="@id/btnPlus" />
        <!-- Plus Button -->
        <ImageView
            android:id="@+id/btnMinus"
            android:layout_width="18dp"
            android:layout_height="25dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="0"
            android:layout_marginTop="5dp"
            android:paddingTop="10dp"
            android:backgroundTint="#E0E0E0"
            android:src="@drawable/baseline_maximize_24"
            app:layout_constraintRight_toLeftOf="@id/btnAdd"
            app:layout_constraintTop_toBottomOf="@id/tvQuantity" />
        <!-- Add Button -->
    </LinearLayout>

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_weight="0"
        android:backgroundTint="#B41F3F"
        android:text="Add"
        android:visibility="visible"
        android:textColor="#FFffff"
        android:textSize="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />






    <TextView
        android:id="@+id/tvTotalPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginRight="34dp"
        app:layout_constraintStart_toStartOf="parent"
        android:text="00.0"
        app:layout_constraintTop_toBottomOf="@id/ll_p_details"
        android:textColor="#127208"
         />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvTotalPrice"
        android:background="#A09898"/>
</androidx.constraintlayout.widget.ConstraintLayout>